# ─── Required: Stock Data ────────────────────────────────────────────────────
# Get a FREE Finnhub API key at https://finnhub.io/register (no credit card)
# Without this key the app falls back to Yahoo Finance (may rate-limit)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ─── Optional: AI Providers ──────────────────────────────────────────────────
# Configure one or more AI providers. The app detects available keys at runtime
# and lets users pick among the configured providers in Settings.
#
# Gemini: free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
#
# OpenAI: API key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
#
# Anthropic Claude: API key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Optional: Watchlist Customization ───────────────────────────────────────
# Comma-separated list of ticker symbols and/or Yahoo-style crypto pairs
# Examples: AAPL,MSFT,NVDA,BTC-USD,ETH-USD,SOL-USD
# WATCHLIST_SYMBOLS=AAPL,MSFT,GOOGL,NVDA,AMZN,META,BTC-USD,ETH-USD,SOL-USD

# ─── Optional: Twelve Data (RSI/MA indicators when Yahoo Finance rate-limits) ─
# Free key at https://twelvedata.com/pricing — no credit card needed
# Without this, indicators show defaults until Yahoo Finance rate-limit resets.
# TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# ─── Optional: Alpha Vantage (enhanced news) ─────────────────────────────────
# Get a free key at https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ─── App Config ──────────────────────────────────────────────────────────────
# For production deployment, set to your domain
# NEXT_PUBLIC_APP_URL=https://your-domain.com
